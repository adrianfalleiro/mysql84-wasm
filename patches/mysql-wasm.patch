diff --git a/mysys/emscripten_timers.cc b/mysys/emscripten_timers.cc
new file mode 100644
index 00000000..dcc8a115
--- /dev/null
+++ b/mysys/emscripten_timers.cc
@@ -0,0 +1,115 @@
+// Emscripten has pthreads but no POSIX timer_create/SIGEV_THREAD backend.
+#include "my_timer.h"
+
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <system_error>
+#include <thread>
+#include <unordered_map>
+
+struct emscripten_timer_state {
+  my_timer_t *timer;
+  std::chrono::steady_clock::time_point deadline;
+  bool armed = false;
+};
+
+namespace {
+std::mutex timer_mutex;
+std::condition_variable timer_changed;
+std::unordered_map<os_timer_t, std::shared_ptr<emscripten_timer_state>> timers;
+std::thread timer_worker;
+bool stopping = false;
+
+void run_timers() {
+  std::unique_lock<std::mutex> lock(timer_mutex);
+  while (!stopping) {
+    std::shared_ptr<emscripten_timer_state> next;
+    for (const auto &entry : timers) {
+      if (entry.second->armed &&
+          (!next || entry.second->deadline < next->deadline))
+        next = entry.second;
+    }
+    if (!next) {
+      timer_changed.wait(lock);
+    } else if (std::chrono::steady_clock::now() < next->deadline) {
+      timer_changed.wait_until(lock, next->deadline);
+    } else {
+      // Commit the notification before unlocking. Cancel then reports state=0,
+      // so sql_timer retains its owner until this notification is delivered.
+      next->armed = false;
+      my_timer_t *timer = next->timer;
+      auto notify = timer->notify_function;
+      lock.unlock();
+      notify(timer);  // The callback may delete its own timer.
+      lock.lock();
+    }
+  }
+}
+}  // namespace
+
+int my_timer_initialize() {
+  std::lock_guard<std::mutex> lock(timer_mutex);
+  if (timer_worker.joinable()) return 0;
+  stopping = false;
+  try {
+    timer_worker = std::thread(run_timers);
+  } catch (const std::system_error &error) {
+    errno = error.code().value();
+    return -1;
+  }
+  return 0;
+}
+
+void my_timer_deinitialize() {
+  {
+    std::lock_guard<std::mutex> lock(timer_mutex);
+    stopping = true;
+    timer_changed.notify_all();
+  }
+  if (timer_worker.joinable()) timer_worker.join();
+  std::lock_guard<std::mutex> lock(timer_mutex);
+  timers.clear();
+}
+
+int my_timer_create(my_timer_t *timer) {
+  try {
+    auto state = std::make_shared<emscripten_timer_state>();
+    state->timer = timer;
+    std::lock_guard<std::mutex> lock(timer_mutex);
+    timers.emplace(state.get(), state);
+    timer->id = state.get();
+  } catch (const std::bad_alloc &) {
+    errno = ENOMEM;
+    return -1;
+  }
+  return 0;
+}
+
+int my_timer_set(my_timer_t *timer, unsigned long milliseconds) {
+  std::lock_guard<std::mutex> lock(timer_mutex);
+  auto &state = *timers.at(timer->id);
+  state.deadline = std::chrono::steady_clock::now() +
+                   std::chrono::milliseconds(milliseconds);
+  state.armed = milliseconds != 0;
+  timer_changed.notify_all();
+  return 0;
+}
+
+int my_timer_cancel(my_timer_t *timer, int *state) {
+  std::lock_guard<std::mutex> lock(timer_mutex);
+  auto &entry = *timers.at(timer->id);
+  *state = entry.armed ? 1 : 0;
+  entry.armed = false;
+  timer_changed.notify_all();
+  return 0;
+}
+
+void my_timer_delete(my_timer_t *timer) {
+  std::lock_guard<std::mutex> lock(timer_mutex);
+  timers.erase(timer->id);
+  timer->id = nullptr;
+  timer_changed.notify_all();
+}
